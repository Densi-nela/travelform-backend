```env
# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Enable debugging during development. Always set to false in production.
DEBUG=true

# Django secret key used for cryptographic signing.
# Replace with a strong, randomly generated value. Never commit real secrets.
SECRET_KEY=replace-with-a-long-random-secret

# Comma-separated hostnames allowed to access the Django application.
# Production should contain only the required hostnames.
ALLOWED_HOSTS=localhost,127.0.0.1

# React frontend URL used to generate booking and approval links.
FRONTEND_URL=http://localhost:5173

# Trusted frontend origins for Django CSRF validation.
# Include the scheme (http/https) and port where applicable.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# =============================================================================
# EMAIL NOTIFICATION CONFIGURATION
# =============================================================================
# The application uses the internal Notification Service API for emails
# with attachments, such as flight tickets and travel documents.
# AWS SQS can optionally handle emails without attachments.

# console: Logs notification metadata to the terminal without sending emails.
# live: Sends plain emails via SQS and ticket emails via the internal API.
NOTIFICATION_MODE=live

# true: Route all outgoing emails through the internal Notification Service API.
# false: Use SQS for plain emails and the internal API for ticket emails.
NOTIFICATION_USE_API_FOR_ALL_EMAILS=false

# Base URL of the internal Notification Service API.
# The application automatically appends /notification/email/<endpoint>.
NOTIFICATION_API_URL=http://internal-apis-services-alb-1438949379.eu-west-1.elb.amazonaws.com

# Optional bearer token for authenticating with the Notification Service API.
# Its empty since the internal notification API service does not require authentication.
NOTIFICATION_API_TOKEN=


# =============================================================================
# AWS SQS CONFIGURATION
# =============================================================================
# AWS SQS queues email notifications for processing by the email service.
# Use an IAM role or AWS credential provider chain for authentication.

# AWS region where the SQS queue is hosted.
AWS_REGION=eu-west-1

# Name of the existing SQS email notification queue.
NOTIFICATION_SQS_QUEUE_NAME=notifications-email-queue

# Full SQS queue URL.
# Optional if the application resolves the queue by name using sqs:GetQueueUrl.
NOTIFICATION_SQS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/809752095901/notifications-email-queue


# =============================================================================
# TRAVEL ADMINISTRATION
# =============================================================================

# Comma-separated administrator email addresses or distribution lists.
# Used to send travel booking notifications to the responsible administrators.
TRAVEL_ADMIN_EMAILS=

# Company logo URL used in email templates and notifications.
APA_LOGO_URL=https://www.apainsurance.org/images/AppResources/Apollo_Logo.png


# =============================================================================
# OPTIONAL AWS CREDENTIALS
# =============================================================================
# For local development, prefer AWS CLI profiles or AWS SSO.
# In production, use an IAM role (e.g., an ECS Task Role).
# Never commit actual AWS credentials to version control.

# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_SESSION_TOKEN is required only when using temporary AWS credentials.
```