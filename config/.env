DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5174
# console logs delivery metadata only. live routes plain mail to SQS and ticket mail to the internal service.
NOTIFICATION_MODE=live
# true: all live emails use the internal API. false: only ticket emails use it.
NOTIFICATION_USE_API_FOR_ALL_EMAILS=true
NOTIFICATION_API_URL=http://notification-apis-service.service.apainsurance.ke:8080
NOTIFICATION_API_TOKEN=

# Use an IAM role or the normal AWS credential provider chain; do not hard-code keys.
AWS_REGION=eu-west-1
NOTIFICATION_SQS_QUEUE_NAME=notifications-email-queue
# Optional: omit to resolve the existing queue by name (requires sqs:GetQueueUrl).
NOTIFICATION_SQS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/809752095901/notifications-email-queue
# Comma-separated travel administrators or a distribution-list address.
TRAVEL_ADMIN_EMAILS=marlonmarshall047@gmail.com
EMAIL_LOGO_URL=https://www.apainsurance.org/images/AppResources/Apollo_Logo.png


# Optional local AWS credentials (or use AWS_PROFILE / an IAM role instead).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=  # required only for temporary credentials
